{
  "redirects": [
    {
      "source": "/beheer/:pad*",
      "has": [{ "type": "host", "value": "intake.roll.nl" }],
      "destination": "https://roll.nl/dashboard/:pad*",
      "permanent": false
    },
    {
      "source": "/dashboard/:pad*",
      "has": [{ "type": "host", "value": "intake.roll.nl" }],
      "destination": "https://roll.nl/dashboard/:pad*",
      "permanent": false
    }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self' https://roll.nl https://*.roll.nl" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
